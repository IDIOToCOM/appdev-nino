{
  "name": "Samson",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-android-with-metro.ps1",
    "run-android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-android-with-metro.ps1",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start --port 8088",
    "metro": "react-native start --port 8088",
    "start:window": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-metro-window.ps1",
    "start:metro": "react-native start --port 8088",
    "kill:metro": "powershell -NoProfile -Command \"$p=(Get-NetTCPConnection -LocalPort 8088 -State Listen -EA SilentlyContinue).OwningProcess; if($p){Stop-Process -Id $p -Force; 'Stopped Metro on 8088 (PID '+$p+')'}else{'No process listening on 8088'}\"",
    "android:reverse": "adb reverse tcp:8088 tcp:8088",
    "dev:proxy": "node scripts/dev-forge-proxy.mjs",
    "android:clean-native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean-android-native.ps1",
    "test": "jest",
    "generate-icons": "node scripts/generate-app-icons.mjs",
    "postinstall": "node scripts/patch-nav-assets.mjs"
  },
  "dependencies": {
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native-firebase/app": "^24.0.0",
    "@react-native-firebase/auth": "^24.0.0",
    "@react-native-firebase/messaging": "^24.0.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-native/new-app-screen": "0.83.1",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/stack": "^7.7.2",
    "react": "19.2.0",
    "react-native": "0.83.1",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.23.0",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "redux-saga": "^1.4.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.83.1",
    "@react-native/eslint-config": "0.83.1",
    "@react-native/metro-config": "0.83.1",
    "@react-native/typescript-config": "0.83.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.0",
    "sharp": "^0.34.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
